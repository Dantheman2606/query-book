# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5433/querybook"

# Authentication
JWT_SECRET="super_secret_key"

# Upstash Redis (Rate Limiting)
# For local development with Docker: use redis:// URLs
# For production: use Upstash REST API credentials from https://console.upstash.com
UPSTASH_REDIS_REST_URL="http://redis:6379"
UPSTASH_REDIS_REST_TOKEN=""

# Mail Config
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user"
SMTP_PASS="password"

# App Config
PORT=5001
NEXT_PUBLIC_API_URL="http://localhost:5001/api"
NODE_ENV="development"
