# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5433/querybook"

# Authentication
NEXTAUTH_SECRET="super_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mail Config
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user"
SMTP_PASS="password"
SMTP_FROM="QueryBook <noreply@querybook.app>"

# Redis (Rate Limiting)
# Local default in code: redis://localhost:6379
# Set a reachable Redis host in production if different from localhost.
REDIS_URL="redis://localhost:6379"

# App Config
PORT=5001
NEXT_PUBLIC_API_URL="http://localhost:5001/api"
NODE_ENV="development"
