// Prisma schema file
// Define database models (User, Query, Reply, Tag, Announcement, etc.)
// Define relationships between models
// Configure datasource (PostgreSQL/MySQL) and generator (client)

// =========================
// TO START DB
// docker-compose up -d

// TO CONNECT TO DB AND CREATE TABLES
// npx prisma db push

// TO VISUALIZE DB
// npx prisma studio

// TO SAVE MIGRATION
// npx prisma migrate dev --name add_all_models
// =========================


datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
    student
    faculty
    admin
}

model User{
    id String @id @default(uuid())

    email String @unique
    password String
    name String

    role Role @default(student)
    department String @default("")
    avatarUrl String @default("")
    bio String @db.VarChar(200) @default("")

    isActive Boolean @default(true)
    isVerified Boolean @default(false)

    verificationToken String?
    verificationTokenExpiry DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    announcements Announcement[]
    queries Query[]
    votes Vote[]
    replies Reply[]
    replyvotes ReplyVote[]
}

model Announcement {
  id String @id @default(uuid())

  title String @default("")
  content String
  postedBy String @default("User")

  user User @relation(fields: [userId], references: [id])
  userId String 

  datePosted DateTime @default(now())

  @@index([userId])
}

model Query {
  id String @id @default(uuid())
  title String @default("")
  content String
  postedBy String @default("User")

  upvotes   Int @default(0)
  downvotes Int @default(0)
  // Relations
  votes       Vote[]
  replies     Reply[]
  tags        QueryTag[]

  user        User     @relation(fields: [userId], references: [id])
  userId      String

  datePosted  DateTime @default(now())
  isEdited    Boolean  @default(false)
  dateEdited  DateTime @updatedAt

  @@index([userId])
}

model Vote {
  id       String   @id @default(uuid())

  type     VoteType

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  userId   String

  query    Query    @relation(fields: [queryId], references: [id])
  queryId  String

  @@unique([userId, queryId]) // one vote per user per query
  @@index([queryId])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

model Tag {
  id      String     @id @default(uuid())
  name    String     @unique

  queries QueryTag[]
}

model QueryTag {
  query   Query @relation(fields: [queryId], references: [id])
  queryId String

  tag     Tag   @relation(fields: [tagId], references: [id])
  tagId   String

  @@id([queryId, tagId])
}

model Reply {
  id         String   @id @default(uuid())
  content    String

  // Voting (cached)
  netVotes   Int      @default(0)

  // Relations
  votes      ReplyVote[]

  // Author
  postedBy   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String

  // Parent Query
  query      Query    @relation(fields: [queryId], references: [id])
  queryId    String

  // Self-relation (nested replies)
  parent     Reply?   @relation("ReplyToReply", fields: [parentId], references: [id])
  parentId   String?

  children   Reply[]  @relation("ReplyToReply")

  datePosted DateTime @default(now())

  @@index([userId])
  @@index([queryId, parentId])
}

model ReplyVote {
  id        String   @id @default(uuid())

  type      VoteType

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  reply     Reply    @relation(fields: [replyId], references: [id])
  replyId   String

  @@unique([userId, replyId])
  @@index([replyId])
}